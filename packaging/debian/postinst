#!/bin/sh
set -eu
if [ "$1" = configure ]; then
    python3 -m venv /opt/thothcraft/venv
    /opt/thothcraft/venv/bin/python -m pip install --upgrade /opt/thothcraft/packages/thothcraft-sdk /opt/thothcraft/packages/thothcraft-cli
    echo 'Run: systemctl --user daemon-reload && systemctl --user enable --now thothcraft'
fi
